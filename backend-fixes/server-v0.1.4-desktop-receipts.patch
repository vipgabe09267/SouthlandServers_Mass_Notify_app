+++ b/tools/test_desktop_receipts.php
@@ -0,0 +1,65 @@
+<?php
+declare(strict_types=1);
+require_once dirname(__DIR__) . '/slsmassnotifyserver/api/sipnotify/desktop_receipts.php';
+function checkReceipt($condition, $message) { if (!$condition) { throw new RuntimeException($message); } }
+function rejectsReceipt($callback) {
+    try { $callback(); } catch (Throwable $error) { return; }
+    throw new RuntimeException('Expected storage failure was accepted.');
+}
+$root = sys_get_temp_dir() . '/sls-receipts-' . bin2hex(random_bytes(8));
+mkdir($root, 0700);
+$directory = $root . '/store';
+$store = new SlsDesktopReceipts($directory);
+$now = time();
+$id = 'announcement-20260920220339477893-' . str_repeat('a', 32);
+$second = 'announcement-20260920220411336883-' . str_repeat('b', 32);
+$rows = [
+    ['channel'=>'desktop', 'target'=>'alice', 'event_id'=>$id, 'state'=>'published'],
+    ['channel'=>'desktop', 'target'=>'alice', 'event_id'=>$second, 'state'=>'published'],
+    ['channel'=>'desktop', 'target'=>'bob', 'event_id'=>$id, 'state'=>'published'],
+    ['channel'=>'desktop', 'target'=>'alice', 'state'=>'published'],
+    ['channel'=>'desktop', 'target'=>'alice', 'event_id'=>$id, 'state'=>'uncertain'],
+];
+try {
+    checkReceipt($store->reconcile($rows) === $rows, 'Missing ledger invented delivery.');
+    // Receipt can arrive before any job receipt row has been saved.
+    $at = $store->record('alice', $id, $now);
+    checkReceipt($store->record('alice', $id, $now+1) === $at, 'Retry changed original receipt time.');
+    $store->record('alice', $second, $now+2);
+    $result = $store->reconcile($rows, $now+3);
+    checkReceipt($result[0]['state'] === 'received' && $result[1]['state'] === 'received', 'Second receipt erased first.');
+    checkReceipt($result[2] === $rows[2] && $result[3] === $rows[3] && $result[4] === $rows[4], 'Receipt crossed identity or inferred a missing ID.');
+    checkReceipt($store->reconcile($rows, $now+SlsDesktopReceipts::RETENTION_SECONDS+3) === $rows, 'Expired evidence was treated as current.');
+    checkReceipt(SlsDesktopReceipts::publishedEventId(['noise', 'SLS_DESKTOP_PUBLICATION ' . json_encode(['event_id'=>$id])]) === $id, 'Structured event ID was lost.');
+    checkReceipt(SlsDesktopReceipts::publishedEventId(['SLS_DESKTOP_PUBLICATION {"event_id":"garbage"}']) === '', 'Invalid ID accepted.');
+    $lock = fopen($directory . '/receipts.lock', 'c+b'); flock($lock, LOCK_EX);
+    try { rejectsReceipt(function() use ($store, $second) { $store->record('bob', $second); }); }
+    finally { flock($lock, LOCK_UN); fclose($lock); }
+    $before = file_get_contents($directory . '/receipts.json');
+    rejectsReceipt(function() use ($store) { $store->record('', ''); });
+    checkReceipt(file_get_contents($directory . '/receipts.json') === $before, 'Bad request damaged ledger.');
+    file_put_contents($directory . '/receipts.json', '{broken');
+    rejectsReceipt(function() use ($store, $id) { $store->record('alice', $id); });
+    checkReceipt(file_get_contents($directory . '/receipts.json') === '{broken', 'Corrupt ledger silently reset.');
+    $entries = [];
+    for ($i=0; $i<SlsDesktopReceipts::MAX_ENTRIES; $i++) { $entries[hash('sha256', (string)$i)] = $now-1; }
+    file_put_contents($directory . '/receipts.json', json_encode($entries));
+    $store->record('alice', $id, $now);
+    checkReceipt(count(json_decode(file_get_contents($directory . '/receipts.json'), true)) === SlsDesktopReceipts::MAX_ENTRIES, 'Ledger count unbounded.');
+    checkReceipt($store->reconcile($rows, $now)[0]['state'] === 'received', 'Newest receipt pruned.');
+    unlink($directory . '/receipts.json');
+    mkdir($directory . '/receipts.json');
+    rejectsReceipt(function() use ($store, $id) { $store->record('alice', $id); });
+    rmdir($directory . '/receipts.json');
+    if (PHP_OS_FAMILY !== 'Windows') {
+        file_put_contents($root . '/outside', 'untouched');
+        symlink($root . '/outside', $directory . '/receipts.json');
+        rejectsReceipt(function() use ($store, $id) { $store->record('alice', $id); });
+        checkReceipt(file_get_contents($root . '/outside') === 'untouched', 'Symlink target modified.');
+        unlink($directory . '/receipts.json'); unlink($root . '/outside');
+    }
+    echo "PASS: exact receipts, successive events, idempotency, missing/expired evidence, limits, lock contention and failed storage.\n";
+} finally {
+    foreach (glob($directory . '/*') ?: [] as $path) { if (is_file($path) || is_link($path)) { unlink($path); } }
+    rmdir($directory); rmdir($root);
+}
