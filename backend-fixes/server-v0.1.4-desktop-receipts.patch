new file mode 100644
index 0000000..36756dc
--- /dev/null
+++ b/slsmassnotifyserver/api/sipnotify/desktop_receipts.php
@@ -0,0 +1,155 @@
+<?php
+/** Exact application receipts. No message contents, passwords or human-read claims. */
+final class SlsDesktopReceipts
+{
+    const DIRECTORY = '/var/lib/asterisk/SLS_Mass_Notifications_Plugin/desktop-receipts';
+    const MAX_BYTES = 8388608;
+    const MAX_ENTRIES = 20000;
+    const RETENTION_SECONDS = 604800;
+    private $directory;
+
+    public function __construct($directory = self::DIRECTORY)
+    {
+        $this->directory = rtrim($directory, '/\\');
+    }
+
+    private function checkDirectory($create)
+    {
+        if (!file_exists($this->directory) && !is_link($this->directory)) {
+            if (!$create) { return false; }
+            if (!@mkdir($this->directory, 0750) && !is_dir($this->directory)) {
+                throw new RuntimeException('Receipt storage unavailable.');
+            }
+        }
+        clearstatcache(true, $this->directory);
+        $meta = @lstat($this->directory);
+        if (!$meta || is_link($this->directory) || ($meta['mode'] & 0170000) !== 0040000
+            || (PHP_OS_FAMILY !== 'Windows' && (($meta['mode'] & 0022)
+                || realpath($this->directory) !== $this->directory
+                || !function_exists('posix_geteuid') || posix_geteuid() !== $meta['uid']))) {
+            throw new RuntimeException('Unsafe receipt directory.');
+        }
+        return true;
+    }
+
+    private function openChecked($path, $mode)
+    {
+        clearstatcache(true, $path);
+        $before = @lstat($path);
+        if ($before && (is_link($path) || ($before['mode'] & 0170000) !== 0100000 || $before['nlink'] !== 1)) {
+            throw new RuntimeException('Unsafe receipt file.');
+        }
+        $mask = umask(0027);
+        try { $handle = @fopen($path, $mode); } finally { umask($mask); }
+        if (!$handle) { throw new RuntimeException('Receipt storage unavailable.'); }
+        $opened = fstat($handle);
+        clearstatcache(true, $path);
+        $after = @lstat($path);
+        if (!$after || is_link($path) || ($opened['mode'] & 0170000) !== 0100000 || $opened['nlink'] !== 1
+            || $after['ino'] !== $opened['ino'] || $after['dev'] !== $opened['dev']
+            || (PHP_OS_FAMILY !== 'Windows' && (($opened['mode'] & 0022) || $opened['uid'] !== fileowner($this->directory)))) {
+            fclose($handle);
+            throw new RuntimeException('Unsafe receipt file.');
+        }
+        return $handle;
+    }
+
+    private function read()
+    {
+        $path = $this->directory . '/receipts.json';
+        if (!file_exists($path) && !is_link($path)) { return []; }
+        $handle = $this->openChecked($path, 'rb');
+        try {
+            if (fstat($handle)['size'] > self::MAX_BYTES) { throw new RuntimeException('Receipt storage oversized.'); }
+            $raw = stream_get_contents($handle, self::MAX_BYTES + 1);
+            if (!is_string($raw) || strlen($raw) > self::MAX_BYTES) { throw new RuntimeException('Receipt storage unreadable.'); }
+            $data = json_decode($raw, true, 16, JSON_THROW_ON_ERROR);
+            if (!is_array($data) || count($data) > self::MAX_ENTRIES) { throw new RuntimeException('Invalid receipt storage.'); }
+            return $data;
+        } finally { fclose($handle); }
+    }
+
+    private static function key($username, $eventId)
+    {
+        return hash('sha256', json_encode([$username, $eventId], JSON_THROW_ON_ERROR));
+    }
+
+    private function syncDirectory()
+    {
+        if (PHP_OS_FAMILY === 'Windows' || !function_exists('fsync')) { return; }
+        $handle = @fopen($this->directory, 'r');
+        if (!$handle) { throw new RuntimeException('Receipt directory unavailable.'); }
+        try {
+            if (!@fsync($handle)) { throw new RuntimeException('Receipt directory sync failed.'); }
+        } finally { fclose($handle); }
+    }
+
+    /** Caller must authenticate and authorize this exact journal event first. */
+    public function record($username, $eventId, $now = null)
+    {
+        if (!is_string($username) || $username === '' || strlen($username) > 256
+            || !is_string($eventId) || $eventId === '' || strlen($eventId) > 1024) {
+            throw new RuntimeException('Invalid receipt identity.');
+        }
+        $now = $now ?? time();
+        $this->checkDirectory(true);
+        $lock = $this->openChecked($this->directory . '/receipts.lock', 'c+b');
+        try {
+            if (!flock($lock, LOCK_EX | LOCK_NB)) { throw new RuntimeException('Receipt storage busy.'); }
+            $data = array_filter($this->read(), static function ($at) use ($now) {
+                return is_int($at) && $at > $now - self::RETENTION_SECONDS && $at <= $now;
+            });
+            $key = self::key($username, $eventId);
+            if (isset($data[$key])) { $this->syncDirectory(); return gmdate('c', $data[$key]); }
+            $data[$key] = $now;
+            asort($data, SORT_NUMERIC);
+            $data = array_slice($data, -self::MAX_ENTRIES, null, true);
+            $json = json_encode($data, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
+            if (strlen($json) > self::MAX_BYTES) { throw new RuntimeException('Receipt storage oversized.'); }
+            $temp = $this->directory . '/.receipt-' . bin2hex(random_bytes(16));
+            $handle = $this->openChecked($temp, 'x+b');
+            try {
+                if (fwrite($handle, $json) !== strlen($json) || !fflush($handle)
+                    || (function_exists('fsync') && !fsync($handle))) {
+                    throw new RuntimeException('Receipt write failed.');
+                }
+                fclose($handle); $handle = null;
+                if (!@rename($temp, $this->directory . '/receipts.json')) { throw new RuntimeException('Receipt commit failed.'); }
+                $this->syncDirectory();
+            } finally {
+                if (is_resource($handle)) { fclose($handle); }
+                if (is_file($temp)) { @unlink($temp); }
+            }
+            return gmdate('c', $now);
+        } finally { flock($lock, LOCK_UN); fclose($lock); }
+    }
+
+    public function reconcile(array $rows, $now = null)
+    {
+        $now = $now ?? time();
+        $data = $this->checkDirectory(false) ? $this->read() : [];
+        foreach ($rows as &$row) {
+            if (($row['channel'] ?? '') !== 'desktop' || ($row['state'] ?? '') !== 'published'
+                || empty($row['event_id'])) { continue; }
+            $at = $data[self::key((string)$row['target'], (string)$row['event_id'])] ?? null;
+            if (is_int($at) && $at > $now - self::RETENTION_SECONDS && $at <= $now) {
+                $row['state'] = 'received';
+                $row['received_at'] = gmdate('c', $at);
+                $row['detail'] = 'Desktop application receipt confirmed at ' . $row['received_at'] . '.';
+            }
+        }
+        unset($row);
+        return $rows;
+    }
+
+    public static function publishedEventId(array $output)
+    {
+        foreach ($output as $line) {
+            if (strpos($line, 'SLS_DESKTOP_PUBLICATION ') !== 0) { continue; }
+            $value = json_decode(substr($line, strlen('SLS_DESKTOP_PUBLICATION ')), true);
+            $id = is_array($value) ? ($value['event_id'] ?? '') : '';
+            if (is_string($id) && preg_match('/^announcement-[0-9]{20}-[a-f0-9]{32}$/D', $id)) { return $id; }
+        }
+        return '';
+    }
+}
