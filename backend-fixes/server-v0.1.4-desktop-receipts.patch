diff --git a/tools/test_desktop_receipt_contract.py b/tools/test_desktop_receipt_contract.py
new file mode 100644
index 0000000..f2cd540
--- /dev/null
+++ b/tools/test_desktop_receipt_contract.py
@@ -0,0 +1,127 @@
+"""Isolated producer/ACK contract checks; never connects to a PBX."""
+import ast
+from contextlib import redirect_stdout
+import io
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from unittest import mock
+
+ROOT = Path(__file__).resolve().parents[1]
+API = ROOT / "slsmassnotifyserver/api/sipnotify"
+PHP = os.environ.get("PHP_BINARY", "php")
+
+
+class ReceiptContractTests(unittest.TestCase):
+    def test_publication_reports_exact_id_only_after_successful_write(self):
+        source = ROOT / "slsmassnotifyserver/bin/sls_mass_notify/sls_notify.py"
+        tree = ast.parse(source.read_text(encoding="utf-8"))
+        function = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "push_announcement")
+        namespace = {"json": json, "normalize_announcement_timeout_seconds": int,
+                     "build_announcement_xml": mock.Mock(return_value="xml"),
+                     "new_announcement_id": mock.Mock(return_value="exact-event"),
+                     "announcement_api_record": lambda event, *args, **kwargs: {"id": event},
+                     "append_sipnotify_event": mock.Mock()}
+        exec(compile(ast.Module(body=[function], type_ignores=[]), str(source), "exec"), namespace)
+        capture = io.StringIO()
+        with redirect_stdout(capture):
+            namespace["push_announcement"]({}, "fixture", [], api_only=True, desktop_targets=["alice"])
+        self.assertEqual(json.loads(capture.getvalue().removeprefix("SLS_DESKTOP_PUBLICATION ")), {"event_id": "exact-event"})
+        self.assertEqual(namespace["append_sipnotify_event"].call_args.args[1]["id"], "exact-event")
+        namespace["append_sipnotify_event"].side_effect = OSError("fixture disk failure")
+        capture = io.StringIO()
+        with redirect_stdout(capture), self.assertRaises(OSError):
+            namespace["push_announcement"]({}, "fixture", [], api_only=True, desktop_targets=["alice"])
+        self.assertEqual(capture.getvalue(), "")
+
+    def run_ack(self, event_id, recipient="alice", broken_storage=False):
+        source = (API / "index.php").read_text(encoding="utf-8")
+        route = source[source.index("if ($endpoint === 'desktop/ack') {"):source.index("$streamRequested =")]
+        routing = source[source.index("function desktop_event_routed_to_client"):source.index("function desktop_stream_events_after_cursor")]
+        with tempfile.TemporaryDirectory(prefix="sls-ack-contract-") as temp:
+            folder = Path(temp)
+            directory = folder / "receipts"
+            if broken_storage:
+                directory.write_text("cannot use a file as a directory", encoding="utf-8")
+            helper = (API / "desktop_receipts.php").read_text(encoding="utf-8")
+            helper = helper.replace("const DIRECTORY = '/var/lib/asterisk/SLS_Mass_Notifications_Plugin/desktop-receipts';",
+                                    "const DIRECTORY = '" + directory.as_posix() + "';")
+            (folder / "desktop_receipts.php").write_text(helper, encoding="utf-8")
+            route = route.replace("file_get_contents('php://input', false, null, 0, 4097)",
+                                  "json_encode(['event_id'=>" + json.dumps(event_id) + "])")
+            fixture = """<?php
+function respond($status, $payload) { echo json_encode(['status'=>$status, 'body'=>$payload]); exit; }
+function update_desktop_seen(...$args) {}
+function retained_events($settings) { return [['id'=>'fixture-event', 'desktop_recipients'=>[RECIPIENT]]]; }
+$endpoint='desktop/ack'; $username='alice'; $client=['username'=>'alice']; $settings=[];
+""".replace("RECIPIENT", json.dumps(recipient))
+            script = folder / "index.php"
+            script.write_text(fixture + routing + route, encoding="utf-8")
+            result = subprocess.run([PHP, str(script)], capture_output=True, text=True, check=True, timeout=10)
+            return json.loads(result.stdout)
+
+    def test_authorized_receipt_success(self):
+        result = self.run_ack("fixture-event")
+        self.assertEqual(result["status"], 200)
+        self.assertTrue(result["body"]["ok"])
+        self.assertEqual(result["body"]["event_id"], "fixture-event")
+
+    def test_other_recipient_and_unknown_id_are_rejected(self):
+        self.assertEqual(self.run_ack("fixture-event", recipient="bob")["status"], 400)
+        self.assertEqual(self.run_ack("wrong-event")["status"], 400)
+
+    def test_failed_storage_is_retryable_not_success(self):
+        result = self.run_ack("fixture-event", broken_storage=True)
+        self.assertEqual(result["status"], 503)
+        self.assertFalse(result["body"]["ok"])
+
+    def test_job_reconciles_final_result_rows_and_stops_polling(self):
+        with tempfile.TemporaryDirectory(prefix="sls-job-receipts-") as temp:
+            folder = Path(temp)
+            helper = (API / "desktop_receipts.php").read_text(encoding="utf-8")
+            helper = helper.replace("const DIRECTORY = '/var/lib/asterisk/SLS_Mass_Notifications_Plugin/desktop-receipts';",
+                                    "const DIRECTORY = '" + (folder / "receipts").as_posix() + "';")
+            (folder / "desktop_receipts.php").write_text(helper, encoding="utf-8")
+            trait = (ROOT / "slsmassnotifyserver/AnnouncementDelivery.php").read_text(encoding="utf-8")
+            trait = trait.replace("__DIR__ . '/api/sipnotify/desktop_receipts.php'", "__DIR__ . '/desktop_receipts.php'")
+            (folder / "AnnouncementDelivery.php").write_text(trait, encoding="utf-8")
+            script = folder / "test.php"
+            script.write_text('''<?php
+class SlsAnnouncementJobStore {
+    public static $job;
+    public function __construct($path) {}
+    public function read($id) { return self::$job; }
+    public function directory() { return __DIR__; }
+    public function reconcile($id) {}
+}
+require __DIR__ . '/AnnouncementDelivery.php';
+class ReceiptJobFixture {
+    use \\FreePBX\\modules\\SlsAnnouncementDelivery;
+    private function announcementJobDirectory() { return __DIR__; }
+}
+$fixture = new ReceiptJobFixture();
+$rows = [['channel'=>'desktop','target'=>'alice','event_id'=>'first','state'=>'published']];
+SlsAnnouncementJobStore::$job = ['state'=>'complete','created_at'=>gmdate('c'),
+    'receipts'=>[], 'result'=>['success'=>true,'receipts'=>$rows]];
+$before = $fixture->getAnnouncementJob('job_' . str_repeat('a',32));
+(new SlsDesktopReceipts())->record('alice','first');
+(new SlsDesktopReceipts())->record('alice','second');
+$after = $fixture->getAnnouncementJob('job_' . str_repeat('a',32));
+SlsAnnouncementJobStore::$job['result']['receipts'][0]['event_id'] = 'not-received';
+SlsAnnouncementJobStore::$job['created_at'] = gmdate('c',time()-601);
+$expired = $fixture->getAnnouncementJob('job_' . str_repeat('a',32));
+echo json_encode([$before,$after,$expired]);
+''', encoding="utf-8")
+            result = subprocess.run([PHP, str(script)], capture_output=True, text=True, check=True, timeout=10)
+            before, after, expired = json.loads(result.stdout)
+            self.assertTrue(before["receipt_poll_pending"])
+            self.assertEqual(after["receipts"][0]["state"], "received")
+            self.assertFalse(after["receipt_poll_pending"])
+            self.assertFalse(expired["receipt_poll_pending"])
+
+
+if __name__ == "__main__":
